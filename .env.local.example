# Strava OAuth application credentials.
# Create an app at https://www.strava.com/settings/api
#   - "Authorization Callback Domain" must match your host (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret used to encrypt the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: override the auto-detected base URL (useful behind a proxy or in prod).
# APP_URL=http://localhost:3000

# Database. Local development uses a SQLite file by default (no setup needed):
# DATABASE_PATH=./data/rad-trainer.db
#
# For production / serverless hosting (e.g. Vercel), use a hosted Turso database
# instead of a local file. Create one at https://turso.tech and set:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# KI-Coach: free Google Gemini API key (recommended). Get one at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Alternative coach provider (used only if GEMINI_API_KEY is empty):
# ANTHROPIC_API_KEY=
