# Strava OAuth application credentials.
# Create an app at https://www.strava.com/settings/api
#   - "Authorization Callback Domain" must match your host (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret used to encrypt the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: override the auto-detected base URL (useful behind a proxy or in prod).
# APP_URL=http://localhost:3000

# Required for Milestone 2 (KI-Coach). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
